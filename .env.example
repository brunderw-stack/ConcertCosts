# Copy this file to .env.local and fill in your ConcertCosts project values.
# In Supabase: open ConcertCosts → Connect (or Settings → API Keys)
# Copy the Project URL and the publishable key (or legacy anon/public key).
# Do NOT put a service role or secret key here.

NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here
